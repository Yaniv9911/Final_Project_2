# Copy this file to .env and fill in real values. Never commit .env.

# Which generation provider 4_conversational_rag.py should call.
# This project uses gemini; the anthropic/openai SDKs are not installed.
PROVIDER=gemini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which embedding backend retrieval.py / 3_measure_search.py should use:
# local (sentence-transformers/all-MiniLM-L6-v2, no API key needed),
# openai, or gemini.
EMBEDDING_PROVIDER=local
